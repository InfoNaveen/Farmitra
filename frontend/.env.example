# Farmitra Frontend Environment Variables
# Copy to .env.local for local overrides (already gitignored by Vite)

# In production (Vercel), set this to your Render backend URL:
# VITE_API_URL=https://farmitra-backend.onrender.com
#
# Leave empty or unset for local development — the Vite dev proxy handles it.
VITE_API_URL=
