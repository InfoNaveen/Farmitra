# Copy this file to .env and fill in your values
# NEVER commit .env to version control

OPENAI_API_KEY=sk-...your-key-here...

# HuggingFace API token (get from https://huggingface.co/settings/tokens - READ scope)
HF_API_TOKEN=hf_...your-token-here...

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=10

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# HuggingFace model for disease detection
HF_MODEL=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification
